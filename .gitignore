.report/
.grunt/
.npm/
.eslintcache
.stylelintcache
.rollup.cache/
public/ # Gatsby, etc.
lib-cov/
pids/

# Ignore project-specific directories that are not meant for version control
# Preserve the NewState integration boundary; ignore only runtime state.
NewState/.newstate/
NewState/node_modules/
NewState/.env
dycrag_system/
files/
love/
original/
repo-fixes/
minesweeper_assistant_extension/
stake_originals_assistant_extension/
tests/

# Ignore dependency directories
node_modules/
jspm_packages/
bower_components/
typings/

# Ignore logs and debug files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
dycrag_output.txt

# Ignore environment files
.env

# Ignore IDE and editor specific files
.idea/
.vscode/
*.swp
*.swo
*~
.editorconfig
.prettierrc
.project
.classpath
.settings/

# Ignore backup and temporary files
*.bak
*.tmp
*.zip

# Bro's own internal files
.bro_memory.json
# Legacy modules remain tracked; only generated runtime state is ignored.
.bro/
_fix_python_files.sh
rockyou.txt
extras/

# Ignore files generated by the operating system
.DS_Store
Thumbs.db

# Ignore build outputs and temporary directories
/build/
/dist/
/es/
/lib/
/coverage/
.next/
.nuxt/
.output/
.svelte-kit/
.deno/
.serverless/
